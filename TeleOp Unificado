
package org.firstinspires.ftc.teamcode.teleOp;

import com.qualcomm.robotcore.eventloop.opmode.LinearOpMode;
import com.qualcomm.robotcore.eventloop.opmode.TeleOp;
import com.qualcomm.robotcore.hardware.DcMotor;
import com.qualcomm.robotcore.hardware.DcMotorEx;
import com.qualcomm.robotcore.hardware.DcMotorSimple;
import com.qualcomm.robotcore.util.ElapsedTime;
import com.qualcomm.robotcore.util.Range;

@TeleOp(
        name = "TeleOp Unificado",
        group = "Assistencias"
)
public class TeleOpUnificado extends LinearOpMode {

    // =====================================
    // CONFIGURACOES DA TRACAO
    // =====================================

    private static final double ZONA_MORTA = 0.10;

    private static final double POT_MAX_DRIVE = 1.00;
    private static final double PRECISAO_DRIVE = 0.35;

    private static final double SENS_GIRO = 0.65;

    private static final double RAMPA_ACEL = 2.50;
    private static final double RAMPA_DESACEL = 4.00;

    // Nao ativar sem validar os encoders.
    private static final boolean ASSISTENCIA_RETA = false;

    private static final double KP_RETA = 0.00020;
    private static final double MAX_CORRECAO = 0.07;

    // =====================================
    // INTAKE
    // =====================================

    private static final double SINAL_MI = -1.0;
    private static final double MAX_MI = 1.00;
    private static final double REDUCAO_MI = 0.65;

    // =====================================
    // SHOOTER - PID DE RPM
    // =====================================

    private static final double SINAL_MS = -1.0;

    // Calibrar conforme motor e encoder reais.
    private static final double RPM_MAX = 127.0;
    private static final double TICKS_POR_VOLTA_MS = 560.0;

    private static final double KP_MS = 0.0020;
    private static final double KI_MS = 0.0005;
    private static final double KD_MS = 0.00002;

    private static final double KF_MS = 0.60 / 127.0;

    private static final double REDUCAO_MS = 0.65;
    private static final double MAX_POT_MS = 1.00;

    private static final double LIMITE_INTEGRAL = 100.0;
    private static final double ALPHA_RPM = 0.25;

    // =====================================
    // HARDWARE
    // =====================================

    private DcMotorEx MD;
    private DcMotorEx ME;
    private DcMotorEx MS;
    private DcMotor MI;

    // =====================================
    // ESTADOS DA TRACAO
    // =====================================

    private double atualMD = 0;
    private double atualME = 0;

    private int referenciaMD = 0;
    private int referenciaME = 0;

    private boolean retaAtiva = false;
    private boolean emergencia = false;

    // =====================================
    // ESTADOS DO SHOOTER
    // =====================================

    private double integralMS = 0;
    private double rpmFiltrado = 0;
    private double rpmAnterior = 0;

    private double potenciaMS = 0;
    private double alvoMS = 0;
    private double erroMS = 0;

    private boolean shooterAtivo = false;

    private final ElapsedTime relogio =
            new ElapsedTime();

    // =====================================
    // ZONA MORTA LINEAR
    // =====================================

    private double zonaMorta(double valor) {

        if (Math.abs(valor) < ZONA_MORTA) {
            return 0;
        }

        return Math.copySign(
                (Math.abs(valor) - ZONA_MORTA)
                        / (1.0 - ZONA_MORTA),
                valor
        );
    }

    // =====================================
    // RAMPA DE ACELERACAO
    // =====================================

    private double rampa(
            double atual,
            double alvo,
            double dt) {

        boolean desacelerando =
                Math.abs(alvo) < Math.abs(atual)
                        || atual * alvo < 0;

        double taxa = desacelerando
                ? RAMPA_DESACEL
                : RAMPA_ACEL;

        double passo = taxa * dt;
        double diferenca = alvo - atual;

        if (Math.abs(diferenca) <= passo) {
            return alvo;
        }

        return atual
                + Math.copySign(passo, diferenca);
    }

    // =====================================
    // REFERENCIA DE ENCODERS
    // =====================================

    private void atualizarReferencia() {

        referenciaME = ME.getCurrentPosition();
        referenciaMD = MD.getCurrentPosition();
    }

    // =====================================
    // RESET PID
    // =====================================

    private void resetPID() {

        integralMS = 0;
        rpmFiltrado = 0;
        rpmAnterior = 0;

        potenciaMS = 0;
        alvoMS = 0;
        erroMS = 0;

        shooterAtivo = false;
    }

    // =====================================
    // PARADA GERAL
    // =====================================

    private void pararTudo() {

        MD.setPower(0);
        ME.setPower(0);

        MI.setPower(0);
        MS.setPower(0);

        atualMD = 0;
        atualME = 0;

        retaAtiva = false;

        resetPID();
    }

    // =====================================
    // PID SHOOTER
    // =====================================

    private void controlarShooter(
            double rpmAlvo,
            double dt) {

        if (rpmAlvo <= 0) {

            MS.setPower(0);
            resetPID();

            return;
        }

        if (!shooterAtivo) {

            integralMS = 0;

            rpmFiltrado =
                    Math.abs(MS.getVelocity())
                            * 60.0
                            / TICKS_POR_VOLTA_MS;

            rpmAnterior = rpmFiltrado;
            shooterAtivo = true;
        }

        alvoMS = rpmAlvo;

        double rpmMedido =
                Math.abs(MS.getVelocity())
                        * 60.0
                        / TICKS_POR_VOLTA_MS;

        rpmFiltrado =
                ALPHA_RPM * rpmMedido
                        + (1.0 - ALPHA_RPM)
                        * rpmFiltrado;

        erroMS = alvoMS - rpmFiltrado;

        double derivada =
                (rpmFiltrado - rpmAnterior) / dt;

        rpmAnterior = rpmFiltrado;

        double proporcional =
                KP_MS * erroMS;

        double derivativo =
                -KD_MS * derivada;

        double feedforward =
                KF_MS * rpmAlvo;

        double novaIntegral = Range.clip(
                integralMS + erroMS * dt,
                -LIMITE_INTEGRAL,
                LIMITE_INTEGRAL
        );

        double candidato =
                feedforward
                        + proporcional
                        + KI_MS * novaIntegral
                        + derivativo;

        boolean saturouAlto =
                candidato > MAX_POT_MS
                        && erroMS > 0;

        boolean saturouBaixo =
                candidato < 0
                        && erroMS < 0;

        if (!saturouAlto && !saturouBaixo) {
            integralMS = novaIntegral;
        }

        double comando =
                feedforward
                        + proporcional
                        + KI_MS * integralMS
                        + derivativo;

        potenciaMS = Range.clip(
                comando,
                0,
                MAX_POT_MS
        );

        MS.setPower(
                SINAL_MS * potenciaMS
        );
    }

    // =====================================
    // OPMODE PRINCIPAL
    // =====================================

    @Override
    public void runOpMode() {

        MD = hardwareMap.get(
                DcMotorEx.class, "MD"
        );

        ME = hardwareMap.get(
                DcMotorEx.class, "ME"
        );

        MS = hardwareMap.get(
                DcMotorEx.class, "MS"
        );

        MI = hardwareMap.get(
                DcMotor.class, "MI"
        );

        // =================================
        // DIRECAO DOS MOTORES
        // =================================

        // Pressupoe motores espelhados.
        // Validar com rodas suspensas.

        MD.setDirection(
                DcMotor.Direction.FORWARD
        );

        ME.setDirection(
                DcMotor.Direction.FORWARD   
        );

        // =================================
        // COMPORTAMENTO DOS MOTORES
        // =================================

        MD.setZeroPowerBehavior(
                DcMotor.ZeroPowerBehavior.BRAKE
        );

        ME.setZeroPowerBehavior(
                DcMotor.ZeroPowerBehavior.BRAKE
        );

        MI.setZeroPowerBehavior(
                DcMotor.ZeroPowerBehavior.BRAKE
        );

        MS.setZeroPowerBehavior(
                DcMotor.ZeroPowerBehavior.FLOAT
        );

        MD.setMode(
                DcMotor.RunMode.RUN_WITHOUT_ENCODER
        );

        ME.setMode(
                DcMotor.RunMode.RUN_WITHOUT_ENCODER
        );

        MS.setMode(
                DcMotor.RunMode.RUN_USING_ENCODER
        );

        pararTudo();

        telemetry.addLine("MECA TELEOP V3");
        telemetry.addLine("Velocidade maxima: 100%");
        telemetry.addLine("Aceleracao: 2.50");
        telemetry.addLine("Desaceleracao: 4.00");
        telemetry.addLine("Joystick linear");
        telemetry.addLine("RB: precisao 35%");
        telemetry.addLine("LT: intake");
        telemetry.addLine("X: intake 65%");
        telemetry.addLine("RT: shooter PID");
        telemetry.addLine("Y: reduzir RPM 35%");
        telemetry.addLine("DPAD BAIXO: emergencia");
        telemetry.addLine("Confirmar direcao dos motores");
        telemetry.update();

        waitForStart();

        if (isStopRequested()) {

            pararTudo();
            return;
        }

        atualizarReferencia();
        relogio.reset();

        try {

            while (opModeIsActive()) {

                double dt = Range.clip(
                        relogio.seconds(),
                        0.001,
                        0.10
                );

                relogio.reset();

                // =========================
                // EMERGENCIA
                // =========================

                if (gamepad1.dpad_down) {
                    emergencia = true;
                }

                if (emergencia) {

                    pararTudo();

                    telemetry.addLine(
                            "EMERGENCIA ATIVADA"
                    );

                    telemetry.addLine(
                            "Reinicie o TeleOp"
                    );

                    telemetry.update();

                    idle();
                    continue;
                }

                // =========================
                // JOYSTICKS
                // =========================

                double drive = zonaMorta(
                        -gamepad1.left_stick_y
                );

                double turn = zonaMorta(
                        gamepad1.right_stick_x
                ) * SENS_GIRO;

                double avanco = drive;

                // =========================
                // ASSISTENCIA DE RETA
                // =========================

                double correcao = 0;

                boolean solicitouReta =
                        ASSISTENCIA_RETA
                                && Math.abs(turn) < 0.03
                                && Math.abs(avanco) > 0.15;

                if (solicitouReta) {

                    if (!retaAtiva) {

                        atualizarReferencia();
                        retaAtiva = true;
                    }

                    int deltaME =
                            ME.getCurrentPosition()
                                    - referenciaME;

                    int deltaMD =
                            MD.getCurrentPosition()
                                    - referenciaMD;

                    double erro =
                            deltaME - deltaMD;

                    correcao = Range.clip(
                            erro * KP_RETA,
                            -MAX_CORRECAO,
                            MAX_CORRECAO
                    );

                } else {

                    retaAtiva = false;
                    atualizarReferencia();
                }

                // =========================
                // MISTURA DIFERENCIAL
                // =========================

                double alvoME =
                        avanco + turn - correcao;

                double alvoMD =
                        avanco - turn + correcao;

                double maior = Math.max(
                        1.0,
                        Math.max(
                                Math.abs(alvoME),
                                Math.abs(alvoMD)
                        )
                );

                alvoME /= maior;
                alvoMD /= maior;

                // =========================
                // LIMITADOR DE POTENCIA
                // =========================

                double limite =
                        gamepad1.right_bumper
                                ? PRECISAO_DRIVE
                                : POT_MAX_DRIVE;

                alvoME *= limite;
                alvoMD *= limite;

                // =========================
                // RAMPA
                // =========================

                atualME = rampa(
                        atualME,
                        alvoME,
                        dt
                );

                atualMD = rampa(
                        atualMD,
                        alvoMD,
                        dt
                );

                atualME = Range.clip(
                        atualME,
                        -limite,
                        limite
                );

                atualMD = Range.clip(
                        atualMD,
                        -limite,
                        limite
                );

                ME.setPower(atualME);
                MD.setPower(atualMD);

                // =========================
                // INTAKE
                // =========================

                double lt = Range.clip(
                        gamepad1.left_trigger,
                        0,
                        1
                );

                double potenciaMI =
                        lt * MAX_MI;

                if (gamepad1.x) {
                    potenciaMI *= REDUCAO_MI;
                }

                MI.setPower(
                        SINAL_MI * potenciaMI
                );

                // =========================
                // SHOOTER
                // =========================

                double rt = Range.clip(
                        gamepad1.right_trigger,
                        0,
                        1
                );

                double rpmAlvo =
                        rt * RPM_MAX;

                if (gamepad1.y) {
                    rpmAlvo *= REDUCAO_MS;
                }

                controlarShooter(
                        rpmAlvo,
                        dt
                );

                // =========================
                // TELEMETRIA
                // =========================

                telemetry.addData(
                        "DRIVE",
                        gamepad1.right_bumper
                                ? "PRECISAO"
                                : "NORMAL"
                );

                telemetry.addData(
                        "MD POTENCIA",
                        "%.2f",
                        atualMD
                );

                telemetry.addData(
                        "ME POTENCIA",
                        "%.2f",
                        atualME
                );

                telemetry.addData(
                        "MD ENCODER",
                        MD.getCurrentPosition()
                );

                telemetry.addData(
                        "ME ENCODER",
                        ME.getCurrentPosition()
                );

                telemetry.addData(
                        "MD VELOCIDADE",
                        "%.1f",
                        MD.getVelocity()
                );

                telemetry.addData(
                        "ME VELOCIDADE",
                        "%.1f",
                        ME.getVelocity()
                );

                telemetry.addData(
                        "ASSISTENCIA RETA",
                        ASSISTENCIA_RETA
                                ? "ATIVA"
                                : "DESATIVADA"
                );

                telemetry.addData(
                        "CORRECAO RETA",
                        "%.3f",
                        correcao
                );

                telemetry.addData(
                        "MI POTENCIA",
                        "%.2f",
                        MI.getPower()
                );

                telemetry.addLine(
                        "---- SHOOTER PID ----"
                );

                telemetry.addData(
                        "RPM ALVO",
                        "%.1f",
                        alvoMS
                );

                telemetry.addData(
                        "RPM MEDIDO",
                        "%.1f",
                        rpmFiltrado
                );

                telemetry.addData(
                        "ERRO RPM",
                        "%.1f",
                        erroMS
                );

                telemetry.addData(
                        "SAIDA PID",
                        "%.3f",
                        potenciaMS
                );

                telemetry.update();

                idle();
            }

        } finally {

            pararTudo();
        }
    }
}
